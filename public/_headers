# Cloudflare static assets. HTML gets "public, max-age=0, must-revalidate" by
# default, so only the hashed files need a rule.

# Hashed build output never changes under the same name
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/admin
  X-Robots-Tag: noindex, nofollow

/invite
  X-Robots-Tag: noindex, nofollow
